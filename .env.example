# ──────────────────────────────────────────────────────────────
#  Omnia — environment variables
#  Copy to .env and fill in what you use. All values are optional;
#  the app works with any subset of providers.
# ──────────────────────────────────────────────────────────────

# --- OpenCode Zen (one key for GPT, Claude, Gemini + open models) ----
# Sign in at https://opencode.ai/auth, add billing, and copy your API key.
# Full model list: https://opencode.ai/zen/v1/models
OPENCODE_API_KEY=

# Optional: override the Zen API root (defaults to https://opencode.ai/zen/v1).
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# --- Anthropic (Claude) ----------------------------------------
ANTHROPIC_API_KEY=

# --- OpenAI -----------------------------------------------------
OPENAI_API_KEY=

# --- Google Gemini ----------------------------------------------
GOOGLE_API_KEY=

# --- Ollama (local, http://127.0.0.1:11434) ---------------------
# Optional: only if you run Ollama somewhere else.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- LM Studio (local, http://127.0.0.1:1234) -------------------
# Optional: only if you run LM Studio somewhere else.
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# --- Docker sandbox service -------------------------------------
# URL of the sandbox service (sandbox/server.mjs). The Next.js app
# proxies to it. Defaults to http://127.0.0.1:8787.
# SANDBOX_URL=http://127.0.0.1:8787

# Docker image used for agent sandboxes (build with: npm run sandbox:build)
# SANDBOX_IMAGE=omnia-sandbox:latest

# --- Storage ----------------------------------------------------
# Files (artifacts, uploads, conversations, skills, MCP servers)
# are stored under ./data by default. Override if you like.
# DATA_DIR=./data
