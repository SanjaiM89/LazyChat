QWidget {
  background-color: #1a1918;
  color: #e8e6e2;
  font-size: 14px;
}
QMainWindow, QDialog {
  background-color: #1a1918;
}
QToolTip {
  background-color: #262524;
  color: #e8e6e2;
  border: 1px solid #383634;
  border-radius: 6px;
  padding: 4px 8px;
}
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
  background-color: #121211;
  border: 1px solid #383634;
  border-radius: 10px;
  padding: 6px 10px;
  selection-background-color: #40d9966a;
  color: #e8e6e2;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
  border: 1px solid #80d9966a;
}
QComboBox::drop-down {
  border: none;
  width: 22px;
}
QComboBox QAbstractItemView {
  background-color: #262524;
  border: 1px solid #383634;
  selection-background-color: #383634;
}
QPushButton {
  background-color: #262524;
  border: 1px solid #383634;
  border-radius: 10px;
  padding: 6px 14px;
  color: #e8e6e2;
}
QPushButton:hover {
  background-color: #2f2e2c;
}
QPushButton:pressed {
  background-color: #383634;
}
QPushButton:disabled {
  color: #716c65;
  background-color: #222120;
}
QPushButton[accent="true"] {
  background-color: #d9966a;
  border: 1px solid #d9966a;
  color: #ffffff;
  font-weight: 600;
}
QPushButton[accent="true"]:hover {
  background-color: #e5a87f;
  border-color: #e5a87f;
}
QPushButton[danger="true"] {
  background-color: transparent;
  border: 1px solid #33e07870;
  color: #e07870;
}
QPushButton[danger="true"]:hover {
  background-color: #1fe07870;
}
QPushButton[tool="true"] {
  background: transparent;
  border: none;
  border-radius: 8px;
  padding: 6px 10px;
  color: #716c65;
  font-size: 12.5px;
  font-weight: 500;
}
QPushButton[tool="true"]:hover {
  background-color: #0dffffff;
  color: #a8a29a;
}
QPushButton[tool="true"]:checked {
  background-color: #24d9966a;
  color: #d9966a;
}
QPushButton[iconBtn="true"] {
  background: transparent;
  border: none;
  border-radius: 8px;
  padding: 6px;
  color: #a8a29a;
}
QPushButton[iconBtn="true"]:hover {
  background-color: #0dffffff;
  color: #e8e6e2;
}
QPushButton[iconBtn="true"]:checked {
  background-color: #24d9966a;
  color: #d9966a;
}
QPushButton[ghost="true"] {
  background: transparent;
  border: none;
  color: #a8a29a;
  padding: 4px 8px;
  font-size: 12.5px;
}
QPushButton[ghost="true"]:hover {
  background-color: #0dffffff;
  color: #e8e6e2;
}
QPushButton[send="true"] {
  background-color: #d9966a;
  border: none;
  border-radius: 18px;
  color: #ffffff;
}
QPushButton[send="true"]:hover {
  background-color: #e5a87f;
}
QPushButton[send="true"]:disabled {
  background-color: #383634;
  color: #716c65;
}
QToolButton {
  background: transparent;
  border: none;
  border-radius: 8px;
  padding: 6px;
  color: #a8a29a;
}
QToolButton:hover {
  background-color: #0dffffff;
  color: #e8e6e2;
}
QToolButton[active="true"] {
  background-color: #24d9966a;
  color: #d9966a;
}
QScrollArea {
  border: none;
  background: transparent;
}
QScrollArea > QWidget > QWidget {
  background: transparent;
}
QScrollBar:vertical {
  background: transparent;
  width: 8px;
  margin: 2px;
}
QScrollBar::handle:vertical {
  background: #4d4a46;
  border-radius: 4px;
  min-height: 30px;
}
QScrollBar::handle:vertical:hover {
  background: #5c5853;
}
QScrollBar:horizontal {
  background: transparent;
  height: 8px;
  margin: 2px;
}
QScrollBar::handle:horizontal {
  background: #4d4a46;
  border-radius: 4px;
  min-width: 30px;
}
QScrollBar::add-line, QScrollBar::sub-line {
  height: 0;
  width: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
  background: transparent;
}
QSplitter::handle {
  background: #383634;
  width: 1px;
}
QMenu {
  background-color: #262524;
  border: 1px solid #383634;
  border-radius: 10px;
  padding: 4px;
}
QMenu::item {
  padding: 6px 24px 6px 14px;
  border-radius: 6px;
}
QMenu::item:selected {
  background-color: #383634;
}
QMenu::separator {
  height: 1px;
  background: #383634;
  margin: 4px 8px;
}
QCheckBox {
  spacing: 8px;
  background: transparent;
  border: none;
}
QCheckBox::indicator {
  width: 16px;
  height: 16px;
  border-radius: 4px;
  border: 1px solid #4d4a46;
  background: #121211;
}
QCheckBox::indicator:checked {
  background: #d9966a;
  border-color: #d9966a;
}
QSlider::groove:horizontal {
  height: 4px;
  background: #383634;
  border-radius: 2px;
}
QSlider::handle:horizontal {
  width: 14px;
  height: 14px;
  margin: -5px 0;
  border-radius: 7px;
  background: #d9966a;
}
QTabWidget::pane {
  border: 1px solid #383634;
  border-radius: 10px;
  top: -1px;
}
QTabBar::tab {
  background: #222120;
  border: 1px solid #383634;
  border-bottom: none;
  padding: 6px 14px;
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  margin-right: 2px;
  color: #a8a29a;
}
QTabBar::tab:selected {
  background: #262524;
  color: #e8e6e2;
}
QLabel[muted="true"] {
  color: #716c65;
}
QLabel[secondary="true"] {
  color: #a8a29a;
}
QLabel[heading="true"] {
  font-size: 15px;
  font-weight: 650;
}
QLabel[accent="true"] {
  color: #d9966a;
}
QLabel[info="true"] {
  color: #6ea8dc;
}
QLabel[danger="true"] {
  color: #e07870;
}
QLabel[success="true"] {
  color: #7bc47f;
}
QFrame#sidebar {
  background-color: #1a1918;
  border-right: 1px solid #383634;
}
QFrame#panel {
  background-color: #1a1918;
  border-left: 1px solid #383634;
}
QFrame#header {
  border-bottom: 1px solid #383634;
  background-color: #1a1918;
}
QFrame#composer {
  background-color: #1a1918;
}
QFrame#composerBox {
  background-color: #262524;
  border: 1px solid #4d4a46;
  border-radius: 22px;
}
QFrame#composerBox:focus-within {
  border: 1px solid #80d9966a;
}
QListWidget {
  background: transparent;
  border: none;
  outline: none;
}
QListWidget::item {
  padding: 8px 10px;
  border-radius: 8px;
  margin: 1px 4px;
}
QListWidget::item:selected {
  background-color: #24d9966a;
  color: #e8e6e2;
}
QListWidget::item:hover {
  background-color: #0dffffff;
}
QStatusBar {
  background: #121211;
  border-top: 1px solid #383634;
  color: #716c65;
}
QProgressBar {
  background: #383634;
  border: none;
  border-radius: 4px;
  height: 6px;
  text-align: center;
  color: transparent;
}
QProgressBar::chunk {
  background: #d9966a;
  border-radius: 4px;
}
QGroupBox {
  border: 1px solid #383634;
  border-radius: 10px;
  margin-top: 12px;
  padding-top: 8px;
  background: #121211;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 4px;
  color: #a8a29a;
}
QTableWidget {
  background: #121211;
  gridline-color: #383634;
  border: 1px solid #383634;
}
QHeaderView::section {
  background: #222120;
  color: #a8a29a;
  border: none;
  border-right: 1px solid #383634;
  border-bottom: 1px solid #383634;
  padding: 4px 8px;
}
QFrame#runBar {
  background-color: #24d9966a;
  border: 1px solid #40d9966a;
  border-radius: 16px;
}
QFrame#tile {
  background-color: #24d9966a;
  border: none;
  border-radius: 8px;
}
QFrame#tileInfo {
  background-color: #1f6ea8dc;
  border: none;
  border-radius: 8px;
}
QFrame#suggestion {
  background-color: #262524;
  border: 1px solid #383634;
  border-radius: 16px;
}
QFrame#suggestion:hover {
  background-color: #2f2e2c;
  border-color: #4d4a46;
}
QLabel[badge="true"] {
  background-color: #383634;
  border-radius: 9999px;
  padding: 2px 8px;
  color: #a8a29a;
  font-size: 11px;
}
QLabel[badgeSuccess="true"] {
  background-color: #1f7bc47f;
  border-radius: 9999px;
  padding: 2px 8px;
  color: #7bc47f;
  font-size: 11px;
}
QLabel[badgeWarning="true"] {
  background-color: #24d9a441;
  border-radius: 9999px;
  padding: 2px 8px;
  color: #d9a441;
  font-size: 11px;
}
QLabel[badgeDanger="true"] {
  background-color: #1fe07870;
  border-radius: 9999px;
  padding: 2px 8px;
  color: #e07870;
  font-size: 11px;
}
QLabel[badgeInfo="true"] {
  background-color: #1f6ea8dc;
  border-radius: 9999px;
  padding: 2px 8px;
  color: #6ea8dc;
  font-size: 11px;
}
QFrame#suggestion {
  background-color: #262524;
  border: 1px solid #383634;
  border-radius: 16px;
}
QFrame#suggestion:hover {
  background-color: #2f2e2c;
  border-color: #66d9966a;
}
QWidget#convRow {
  background: transparent;
  border: none;
  border-radius: 8px;
}
QWidget#convRow[active="true"] {
  background-color: #24d9966a;
}
QToolButton#modelPill,
QPushButton#modelPill {
  background: transparent;
  border: none;
  border-radius: 8px;
  padding: 5px 10px;
  color: #a8a29a;
  font-size: 13px;
  font-weight: 500;
  min-height: 26px;
}
QToolButton#modelPill:hover,
QPushButton#modelPill:hover {
  background-color: #0dffffff;
  color: #e8e6e2;
}
QPushButton#subchatFab {
  background-color: #262524;
  border: 1px solid #383634;
  border-radius: 18px;
  color: #a8a29a;
}
QPushButton#subchatFab:hover {
  border-color: #80d9966a;
  color: #d9966a;
}
QPushButton[thinking="true"] {
  background: transparent;
  border: none;
  border-radius: 8px;
  padding: 6px 10px;
  color: #716c65;
  font-size: 12.5px;
  font-weight: 500;
}
QPushButton[thinking="true"]:hover {
  background-color: #0dffffff;
  color: #a8a29a;
}
QPushButton[thinking="true"]:checked {
  background-color: #1f6ea8dc;
  color: #6ea8dc;
}
QFrame#fileChip {
  background-color: #222120;
  border: 1px solid #383634;
  border-radius: 8px;
}
QFrame#fileChip:hover {
  border-color: #66d9966a;
}
QLabel[statusDot="true"] {
  background-color: #7bc47f;
  border-radius: 4px;
  min-width: 6px;
  max-width: 6px;
  min-height: 6px;
  max-height: 6px;
}
QLabel[statusDot="false"] {
  background-color: #d9a441;
  border-radius: 4px;
  min-width: 6px;
  max-width: 6px;
  min-height: 6px;
  max-height: 6px;
}
